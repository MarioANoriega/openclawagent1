{
  "name": "pet-plus-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply pet-plus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pet-plus-db --remote"
  },
  "dependencies": {
    "hono": "^4.11.6",
    "jose": "^6.0.0",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.50.0"
  }
}
