{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pet-plus-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pet-plus-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "STRIPE_PRICE_MONTHLY": "price_replace_me_monthly",
    "STRIPE_PRICE_YEARLY": "price_replace_me_yearly",
    "APP_URL_SCHEME": "petplus"
  }
}
