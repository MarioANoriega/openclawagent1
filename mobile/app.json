{
  "expo": {
    "name": "Pet Plus",
    "slug": "pet-plus",
    "scheme": "petplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F5132"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petplus.app"
    },
    "android": {
      "package": "com.petplus.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pet Plus uses your photo library so you can set a profile picture for each pet.",
          "cameraPermission": "Pet Plus uses your camera so you can take a profile picture for each pet."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://your-worker-subdomain.workers.dev"
    }
  }
}
