# NextAuth — required in production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client ID)
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (developer.apple.com -> Certificates, IDs & Profiles)
# Requires a paid Apple Developer account. Client secret is a signed JWT.
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
